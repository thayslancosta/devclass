        "query": "mutation CriarAluno($input: CriarAlunoInput!) {\n  criarAluno(input: $input) {\n    id\n    nome\n    generoGramatical\n    status\n    nomeResponsavel\n    generoResponsavel\n    contatoResponsavel\n  }\n}\n",
        "variables": "{\n  \"input\": {\n    \"nome\": \"Caio Rocha\",\n    \"generoGramatical\": \"masculino\",\n    \"contatoResponsavel\": \"(85) 98888-0000\"\n  }\n}"
