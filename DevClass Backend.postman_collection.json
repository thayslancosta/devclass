   "description": "Fase 3 — Ramon Trindade. Rode na ordem. Preencha antes: baseUrl, professorToken, professorTokenB, turmaId, turmaIdMesmoPeriodo, turmaIdOutroSemestre e turmaIdProfessorB.",
   "item": [
    {
     "name": "01 - Criar aluno sem responsável",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{professorToken}}",
        "type": "text"
       }
      ],
      "body": {
       "mode": "graphql",
       "graphql": {
        "query": "mutation CriarAluno($input: CriarAlunoInput!) {\n  criarAluno(input: $input) {\n    id\n    nome\n    generoGramatical\n    status\n    nomeResponsavel\n    generoResponsavel\n    contatoResponsavel\n  }\n}\n",
        "variables": "{\n  \"input\": {\n    \"nome\": \"Ana Souza\",\n    \"generoGramatical\": \"feminino\"\n  }\n}"
       }
      },
      "url": {
       "raw": "{{baseUrl}}/graphql",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "graphql"
       ]
      },
      "description": "O aluno pode existir sem nenhum dado de responsável."
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const r = pm.response.json();",
         "pm.test('sem erros', () => pm.expect(r.errors, JSON.stringify(r.errors)).to.be.undefined);",
         "pm.collectionVariables.set('alunoId', r.data.criarAluno.id);",
         "pm.test('status ativo', () => pm.expect(r.data.criarAluno.status).to.eql('ativo'));",
         "pm.test('sem responsavel', () => pm.expect(r.data.criarAluno.nomeResponsavel).to.be.null);"
        ]
       }
      }
     ]
    },
