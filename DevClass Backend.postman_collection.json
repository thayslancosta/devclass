     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const r = pm.response.json();",
         "pm.test('devolve erro', () => pm.expect(r.errors).to.be.an('array'));",
         "pm.test('mensagem clara em portugues', () => pm.expect(r.errors[0].message).to.include('Informe o nome do responsável'));",
         "pm.test('nao vaza erro bruto do MongoDB', () => pm.expect(r.errors[0].message).to.not.match(/E11000|duplicate key|stack/i));",
         "pm.test('codigo BAD_USER_INPUT', () => pm.expect(r.errors[0].extensions.code).to.eql('BAD_USER_INPUT'));"
        ]
       }
      }
     ]
